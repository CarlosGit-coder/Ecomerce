# Docker Compose local: o hostname "mongo" é resolvido entre containers.
# Para executar Python fora do Docker, use mongodb://localhost:27017.
MONGO_URI=mongodb://mongo:27017
# Para usar Atlas no Docker, substitua a URI acima pela connection string SRV:
# mongodb+srv://USUARIO:SENHA@cluster.exemplo.mongodb.net/?retryWrites=true&w=majority&appName=ByteCare
# URL-encode caracteres especiais da senha (por exemplo, @ vira %40).
MONGO_DB=Ecomerce
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=troque-esta-chave-local
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-publishable-ou-anon
WHATSAPP_NUMBER=5586988166764
CATALOG_CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO
